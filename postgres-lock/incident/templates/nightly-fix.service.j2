[Unit]
Description=IncidentSim nightly data fix for orders
After=network.target {{ pg_unit }}
Wants={{ pg_unit }}

[Service]
Type=simple
User={{ worker_user }}
Group={{ worker_user }}
Environment="DATABASE_DSN=host=/var/run/postgresql dbname={{ app_database }} user={{ worker_user }}"
ExecStart=/usr/bin/python3 {{ worker_root }}/nightly_fix.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
